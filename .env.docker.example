# Docker Compose local development environment variables
# Copy this file to .env.docker and fill in your values

POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_local_db_password
POSTGRES_DB=consultiq
DATABASE_URL=postgresql://postgres:your_local_db_password@postgres:5432/consultiq
JWT_SECRET=your_local_jwt_secret
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000