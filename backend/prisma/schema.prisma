generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------Enums---------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  PROJECT_MANAGER
  CONSULTANT_MANAGER
  CONSULTANT
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  LOCKED
  ARCHIVED
}

enum TokenType {
  ACTIVATION
  PASSWORD_RESET
  REFRESH
}

enum AuditOutcome {
  SUCCESS
  USER_NOT_FOUND
  ACCOUNT_PENDING
  ACCOUNT_SUSPENDED
  ACCOUNT_LOCKED
  FAILED_PASSWORD
}

enum CompetencyLevel {
  BEGINNER
  INTERMEDIATE
  EXPERT
}

enum PlacementStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  TERMINATED
}

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  CLOSED
  ARCHIVED
  COMPLETED
}

enum ConsultantAvailability {
  AVAILABLE
  UNAVAILABLE
  ON_LEAVE
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum WorkModel {
  ONSITE
  REMOTE
  HYBRID
}

enum ScoringFactorName {
  SKILL_ALIGNMENT
  COMPETENCY_LEVEL
  AVAILABILITY
  LOCATION
  COST_TO_COMPANY
}

enum UploadStatus {
  PENDING
  UPLOADING
  UPLOADED
  FAILED
  DELETED
}

enum ExtractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVIEW_REQUIRED
  SECURITY_REJECTED
}

enum SecurityReviewStatus {
  NONE
  PENDING
  CLEARED
  REJECTED
}

enum MatchRunStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum CvParsingMethod {
  AI_ASSISTED
  RULE_BASED
}

enum AuditAction {
  PLACEMENT_CREATED
  PLACEMENT_UPDATED
  PLACEMENT_CANCELLED
  CV_EXTRACTED
  CV_SECURITY_CLEARED
  CV_SECURITY_REJECTED
}

enum GapSeverity {
  COVERED
  AT_RISK
  CRITICAL
}
// ---------------------------------------- RBAC Models------------------------------------

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RoleDefinition {
  id          String   @id @default(uuid())
  name        Role     @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  users           User[]

  @@map("roles")
}

// RolePermission — join table mapping which permissions belong to which role.
model RolePermission {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------- Models -----------------------------

model User {
  id                    String               @id @default(uuid())
  fullName              String
  email                 String               @unique //email                 String               @unique  @db.Citext
  passwordHash          String?
  role                  Role
  roleId                String?              @map("role_id")
  roleDefinition        RoleDefinition?      @relation(fields: [roleId], references: [id])
  status                UserStatus           @default(PENDING)
  failedAttempts        Int                  @default(0)
  lockedUntil           DateTime?
  isLocked              Boolean              @default(false)
  termsAcceptedAt       DateTime?
  tenantId              String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  deletedAt             DateTime?            @map("delete_at")
  tokens                Token[]
  auditLogs             authAuditLog[]
  auditLogEntries       AuditLog[]
  consultant            Consultant?
  managedProjects       ProjectManager[]
  managedConsultants    ConsultantManager[]
  scoringConfigAudits   ScoringConfigAudit[]
  notifications         Notification[]
  matchRuns             MatchRun[]
  cvFiles               CvFile[]
  adminActionsPerformed AdminAuditLog[]      @relation("AdminActions")
  adminActionsReceived  AdminAuditLog[]      @relation("AdminTargets")

  @@index([status])
  @@map("users")
}

model Token {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String
  type      TokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  familyId  String? // groups rotated refresh tokens from the same login session

  @@map("tokens")
}

model Consultant {
  id               String                 @id @default(uuid())
  userId           String                 @unique
  user             User                   @relation(fields: [userId], references: [id])
  addressLine1     String
  addressLine2     String?
  suburb           String?
  city             String
  province         String
  postalCode       String?
  latitude         Float?
  longitude        Float?
  placeId          String?
  formattedAddress String?
  phone            String?
  idNumber         String?
  nationality      String?
  costToCompany    Float
  capacity         Int                    @default(100)
  availability     ConsultantAvailability @default(AVAILABLE)
  tenantId         String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  pictureData      Bytes?
  pictureMimeType  String?

  skills                ConsultantSkill[]
  certificates          Certificate[]
  placements            ProjectPlacement[]
  cvFiles               CvFile[]
  managers              ConsultantManager[]
  consultantExperiences ConsultantExperience[]
  education             ConsultantEducation[]
  matchRunResults       MatchRunResult[]
  hadSecurityFlagOnIntake Boolean @default(false)

  @@map("consultants")
}

model ConsultantManager {
  id           String     @id @default(uuid())
  userId       String
  consultantId String
  user         User       @relation(fields: [userId], references: [id])
  consultant   Consultant @relation(fields: [consultantId], references: [id])
  assignedAt   DateTime   @default(now())

  @@unique([userId, consultantId])
  @@map("consultant_managers")
}

model Skill {
  id       String  @id @default(uuid())
  name     String  @unique
  category String
  tenantId String?

  consultantSkills ConsultantSkill[]
  projectSkills    ProjectSkill[]

  @@map("skills")
}

model ConsultantSkill {
  id              String          @id @default(uuid())
  consultantId    String
  skillId         String
  competencyLevel CompetencyLevel
  yearsExperience Int
  confidenceLevel Int
  consultant      Consultant      @relation(fields: [consultantId], references: [id])
  skill           Skill           @relation(fields: [skillId], references: [id])

  @@unique([consultantId, skillId])
  @@index([skillId, consultantId])
  @@map("consultant_skills")
}

model ConsultantEducation {
  id            String     @id @default(uuid())
  consultantId  String
  consultant    Consultant @relation(fields: [consultantId], references: [id])
  institution   String
  qualification String
  startDate     DateTime
  endDate       DateTime?
  fileName      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("consultant_education")
}

model Certificate {
  id           String     @id @default(uuid())
  consultantId String
  title        String
  issuingBody  String
  startDate    DateTime?
  endDate      DateTime?
  uploadedAt   DateTime   @default(now())
  consultant   Consultant @relation(fields: [consultantId], references: [id])

  @@map("certificates")
}

model CvFile {
  id               String           @id @default(uuid())
  userId           String
  consultantId     String?
  uploadedByUserId String?
  fileName         String
  mimeType         String
  fileSize         Int
  s3Key            String
  s3Url            String
  uploadStatus     UploadStatus     @default(UPLOADED)
  extractionStatus ExtractionStatus @default(PENDING)
  securityReviewStatus  SecurityReviewStatus @default(NONE)
  securityReviewedAt    DateTime?
  securityReviewedBy    String?
  parsingMethod    CvParsingMethod  @default(RULE_BASED)
  rawText          String?
  parsedData       Json?
  uploadedAt       DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  consultant       Consultant?      @relation(fields: [consultantId], references: [id])
  user             User             @relation(fields: [userId], references: [id])

  @@index([securityReviewStatus])
  @@index([consultantId, securityReviewStatus])
  @@index([uploadedByUserId, securityReviewStatus])
  @@map("cv_files")
}

model Project {
  id               String                   @id @default(uuid())
  projectName      String
  clientName       String
  description      String?
  addressLine1     String
  addressLine2     String?
  suburb           String?
  city             String
  province         String
  postalCode       String
  latitude         Float?
  longitude        Float?
  placeId          String?
  formattedAddress String?
  startDate        DateTime
  endDate          DateTime?
  teamSize         Int
  allocation       Int // Renamed from requiredAllocationPercentage
  budget           Float // Renamed from clientBillingBudget
  workModel        WorkModel                @default(ONSITE)
  status           ProjectStatus            @default(OPEN)
  tenantId         String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  archivedAt       DateTime?                @map("archived_at")
  skills           ProjectSkill[]
  managers         ProjectManager[]
  placements       ProjectPlacement[]
  scoringOverrides ProjectScoringOverride[]

  auditLogs ProjectAuditLog[]
  matchRuns MatchRun[]
  skillGapSeverity GapSeverity @default(COVERED)

  @@map("projects")
}

model ProjectSkill {
  id         String          @id @default(uuid())
  projectId  String
  skillId    String
  competency CompetencyLevel // Renamed from minimumCompetency
  years      Int
  mandatory  Boolean         @default(true) // Renamed from isMandatory

  project Project @relation(fields: [projectId], references: [id])
  skill   Skill   @relation(fields: [skillId], references: [id])

  @@unique([projectId, skillId])
  @@map("project_skills")
}

model ProjectManager {
  id        String  @id @default(uuid())
  userId    String
  projectId String
  user      User    @relation(fields: [userId], references: [id])
  project   Project @relation(fields: [projectId], references: [id])

  @@unique([userId, projectId])
  @@map("project_managers")
}

model ProjectPlacement {
  id           String          @id @default(uuid())
  projectId    String
  consultantId String
  startDate    DateTime
  endDate      DateTime?
  allocation   Int
  status       PlacementStatus @default(ACTIVE)
  createdAt    DateTime        @default(now())
  project      Project         @relation(fields: [projectId], references: [id])
  consultant   Consultant      @relation(fields: [consultantId], references: [id])

  @@index([consultantId, status, startDate, endDate])
  @@index([projectId, consultantId, status])
  @@map("project_placements")
}

// Currently used to track archiving and unarchiving projects (can be used to track project status changes)
model ProjectAuditLog {
  id        String   @id @default(uuid())
  projectId String
  action    String // "ARCHIVED", "UNARCHIVED"
  userId    String // Admin or PM 
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])

  @@map("project_audit_logs")
}

model authAuditLog {
  id        String       @id @default(uuid())
  email     String
  outcome   AuditOutcome
  userId    String?
  ipAddress String
  userAgent String?
  timestamp DateTime     @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("auth_audit_logs")
}

model AdminAuditLog {
  id            String   @id @default(uuid())
  performedById String   @map("performed_by_id")
  targetUserId  String   @map("target_user_id")
  action        String
  previousValue String   @map("previous_value")
  newValue      String   @map("new_value")
  timestamp     DateTime @default(now())

  performedBy User @relation("AdminActions", fields: [performedById], references: [id])
  targetUser  User @relation("AdminTargets", fields: [targetUserId], references: [id])

  @@map("admin_audit_logs")
}

model ConsultantExperience {
  id           String     @id @default(uuid())
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id])
  jobTitle     String
  companyName  String
  jobType      JobType
  workModel    WorkModel
  startDate    DateTime
  endDate      DateTime?
  description  String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("consultant_experience")
}

model ConsultancyScoringConfig {
  id                   String            @id @default(uuid())
  factorName           ScoringFactorName @unique
  weight               Float
  active               Boolean           @default(true)
  hardExclusionEnabled Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@map("consultancy_scoring_configs")
}

model ProjectScoringOverride {
  id                   String            @id @default(uuid())
  projectId            String
  factorName           ScoringFactorName
  overrideWeight       Float
  active               Boolean           @default(true)
  hardExclusionEnabled Boolean           @default(false)
  createdAt            DateTime          @default(now())

  project Project @relation(fields: [projectId], references: [id])

  @@unique([projectId, factorName])
  @@map("project_scoring_overrides")
}

model ScoringConfigAudit {
  id             String   @id @default(uuid())
  adminUserId    String
  admin          User     @relation(fields: [adminUserId], references: [id])
  previousValues Json
  newValues      Json
  timestamp      DateTime @default(now())

  @@map("scoring_config_audit")
}

model Notification {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  title      String
  body       String
  isRead     Boolean  @default(false) @map("is_read")
  isArchived Boolean  @default(false) @map("is_archived")
  link       String?
  createdAt  DateTime @default(now()) @map("created_at")
  archivedAt DateTime @default(now()) @map("archived_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model MatchRun {
  id                       String           @id @default(uuid())
  projectId                String
  project                  Project          @relation(fields: [projectId], references: [id])
  executedByUserId         String
  executedByUser           User             @relation(fields: [executedByUserId], references: [id])
  status                   MatchRunStatus
  totalConsultantsScored   Int              @default(0)
  totalConsultantsExcluded Int              @default(0)
  totalConsultantsPlaced   Int              @default(0)
  progress                 Int              @default(0)
  errorMessage             String?
  results                  MatchRunResult[]
  configurationSnapshot    Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, createdAt])
  @@index([projectId, status])
}

model MatchRunResult {
  id           String     @id @default(uuid())
  matchRunId   String
  matchRun     MatchRun   @relation(fields: [matchRunId], references: [id], onDelete: Cascade)
  consultantId String
  totalScore   Float
  rank         Int
  factorScores Json
  isPlaced     Boolean    @default(false)
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([matchRunId, consultantId])
  @@index([matchRunId, rank])
  @@index([consultantId])
}

model AuditLog {
  id           String      @id @default(uuid())
  action       AuditAction
  actingUserId String
  actingUser   User        @relation(fields: [actingUserId], references: [id])
  entityType   String
  entityId     String
  metadata     Json?
  timestamp    DateTime    @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}



enum BlockMobility {
  fluid
  pinned
}

enum TaskStatus {
  Ready
  InProgress
  Done
}

enum TaskPlacementStatus {
  placed
  unplaced
}

enum SlotKind {
  task
  batch
}

enum CalendarEntryType {
  meeting
  training
  travel
  personal
  leave
  ad_hoc @map("ad-hoc")
}

enum CalendarEntryOrigin {
  user
  feed
}

enum IdempotencyKeyType {
  daily_rollover @map("daily-rollover")
  slot_rollover  @map("slot-rollover")
}

model SchedulerWeek {
  id                 String   @id @default(uuid())
  consultantId       String   @map("consultant_id")
  timezone           String
  weekStart          DateTime @map("week_start") @db.Date 
  version            Int      @default(1) 
  lastCommittedAt    DateTime @map("last_committed_at")
  sourceOfLastChange String   @map("source_of_last_change")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  blocks          SchedulerProjectBlock[]
  tasks           SchedulerTask[]
  slots           SchedulerSlot[]
  calendarEntries SchedulerCalendarEntry[]
  dismissals      SchedulerIssueDismissal[]
  pendingChanges  SchedulerPendingChange[]

  @@unique([consultantId, weekStart])
  @@map("scheduler_weeks")
}

model SchedulerProjectBlock {
  id               String        @id @default(uuid())
  weekId           String        @map("week_id")
  projectId        String        @map("project_id")
  placementId      String?       @map("placement_id")
  allocatedMinutes Int           @map("allocated_minutes")
  start            DateTime
  end              DateTime
  mobility         BlockMobility
  userSized        Boolean       @default(true) @map("user_sized")

  week SchedulerWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)

  @@map("scheduler_project_blocks")
}

model SchedulerTask {
  id             String          @id @default(uuid())
  weekId         String          @map("week_id")
  projectId      String          @map("project_id")
  title          String
  tMin           Int             @map("t_min")
  tMax           Int             @map("t_max")
  deadline       DateTime?
  urgency        Int
  complexity     Int
  status         TaskStatus
  dependsOn      Json            @default("[]") @map("depends_on")
  splitFromId    String?         @map("split_from_id")
  carriedOver    Boolean         @default(false) @map("carried_over")
  placement      TaskPlacementStatus
  unplacedReason String?         @map("unplaced_reason") 
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  week      SchedulerWeek       @relation(fields: [weekId], references: [id], onDelete: Cascade)
  subtasks  SchedulerSubtask[]
  slotTasks SchedulerSlotTask[]

  @@map("scheduler_tasks")
}

model SchedulerSubtask {
  id       String  @id @default(uuid())
  taskId   String  @map("task_id")
  title    String
  estimate Int
  done     Boolean @default(false)

  // Relations
  task         SchedulerTask          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  slotSubtasks SchedulerSlotSubtask[]

  @@map("scheduler_subtasks")
}

model SchedulerSlot {
  id      String   @id @default(uuid())
  weekId  String   @map("week_id")
  kind    SlotKind
  blockId String   @map("block_id")
  start   DateTime
  end     DateTime
  locked  Boolean  @default(false)
  daySpan Int      @map("day_span")

  week         SchedulerWeek          @relation(fields: [weekId], references: [id], onDelete: Cascade)
  slotTasks    SchedulerSlotTask[]
  slotSubtasks SchedulerSlotSubtask[]

  @@map("scheduler_slots")
}

model SchedulerSlotTask {
  slotId String @map("slot_id")
  taskId String @map("task_id")

  slot SchedulerSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  task SchedulerTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([slotId, taskId])
  @@map("scheduler_slot_tasks")
}

model SchedulerSlotSubtask {
  slotId    String @map("slot_id")
  subtaskId String @map("subtask_id")

  slot    SchedulerSlot    @relation(fields: [slotId], references: [id], onDelete: Cascade)
  subtask SchedulerSubtask @relation(fields: [subtaskId], references: [id], onDelete: Cascade)

  @@id([slotId, subtaskId])
  @@map("scheduler_slot_subtasks")
}

model SchedulerCalendarEntry {
  id     String              @id @default(uuid())
  weekId String              @map("week_id")
  type   CalendarEntryType
  start  DateTime
  end    DateTime
  tags   Json                @default("[]") 
  origin CalendarEntryOrigin @default(user)

  week SchedulerWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)

  @@map("scheduler_calendar_entries")
}

model PublicHoliday {
  id        String   @id @default(uuid())
  date      DateTime @db.Date
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("public_holidays")
}

model SchedulerIssueDismissal {
  id          String   @id @default(uuid())
  weekId      String   @map("week_id")
  code        String // ReasonCode
  dismissedAt DateTime @default(now()) @map("dismissed_at")

  week SchedulerWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)

  @@unique([weekId, code])
  @@map("scheduler_issue_dismissals")
}

model SchedulerIdempotencyKey {
  id        String             @id @default(uuid())
  key       String
  type      IdempotencyKeyType
  createdAt DateTime           @default(now()) @map("created_at")

  @@unique([key, type])
  @@map("scheduler_idempotency_keys")
}

model SchedulerPendingChange {
  id        String   @id @default(uuid())
  weekId    String   @map("week_id")
  change    Json 
  createdAt DateTime @default(now()) @map("created_at")

  week SchedulerWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)

  @@map("scheduler_pending_changes")
}