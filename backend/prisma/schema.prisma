generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------Enums---------------------------------------------------

enum Role {
  SUPER_ADMIN
  SUPER_ADMIN
  ADMIN
  PROJECT_MANAGER
  CONSULTANT_MANAGER
  CONSULTANT
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  LOCKED
  ARCHIVED
}

enum TokenType {
  ACTIVATION
  PASSWORD_RESET
  REFRESH
}

enum AuditOutcome {
  SUCCESS
  USER_NOT_FOUND
  ACCOUNT_PENDING
  ACCOUNT_SUSPENDED
  ACCOUNT_LOCKED
  FAILED_PASSWORD
}

enum CompetencyLevel {
  BEGINNER
  INTERMEDIATE
  EXPERT
}

enum PlacementStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  TERMINATED
}

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  CLOSED
  ARCHIVED
  COMPLETED
}

enum ConsultantAvailability {
  AVAILABLE
  UNAVAILABLE
  ON_LEAVE
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum WorkModel {
  ONSITE
  REMOTE
  HYBRID
}

enum ScoringFactorName {
  SKILL_ALIGNMENT
  COMPETENCY_LEVEL
  AVAILABILITY
  LOCATION
  COST_TO_COMPANY
}

enum UploadStatus {
  PENDING
  UPLOADING
  UPLOADED
  FAILED
  DELETED
}

enum ExtractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVIEW_REQUIRED
}

enum MatchRunStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

// ---------------------------------------- RBAC Models------------------------------------

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RoleDefinition {
  id          String   @id @default(uuid())
  name        Role     @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  users           User[]

  @@map("roles")
}

// RolePermission — join table mapping which permissions belong to which role.
model RolePermission {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------- Models -----------------------------

model User {
  id              String          @id @default(uuid())
  fullName        String
  email           String          @unique
  passwordHash    String?
  role            Role
  roleId          String?         @map("role_id")
  roleDefinition  RoleDefinition? @relation(fields: [roleId], references: [id])
  status          UserStatus      @default(PENDING)
  failedAttempts  Int             @default(0)
  lockedUntil     DateTime?
  isLocked        Boolean         @default(false)
  termsAcceptedAt DateTime?
  tenantId        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?        @map("delete_at")
  tokens             Token[]
  auditLogs          authAuditLog[]
  consultant         Consultant?
  managedProjects    ProjectManager[]
  managedConsultants ConsultantManager[]

  adminActionsPerformed AdminAuditLog[] @relation("AdminActions")
  adminActionsReceived  AdminAuditLog[] @relation("AdminTargets")
  scoringConfigAudits ScoringConfigAudit[]
  notifications       Notification[]
  matchRuns           MatchRun[]

  @@map("users")
}

model Token {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String
  type      TokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  familyId  String? // groups rotated refresh tokens from the same login session

  @@map("tokens")
}

model Consultant {
  id            String                 @id @default(uuid())
  userId        String                 @unique
  user          User                   @relation(fields: [userId], references: [id])
  addressLine1 String
  addressLine2 String?
  suburb       String?
  city         String
  province     String
  postalCode   String?
  phone         String?
  idNumber      String?
  nationality   String?
  costToCompany Float
  availability  ConsultantAvailability @default(AVAILABLE)
  tenantId      String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  skills                ConsultantSkill[]
  certificates          Certificate[]
  placements            ProjectPlacement[]
  cvFiles               CvFile[]
  managers              ConsultantManager[]
  consultantExperiences ConsultantExperience[]
  matchRunResults       MatchRunResult[]

  @@map("consultants")
}

model ConsultantManager {
  id           String     @id @default(uuid())
  userId       String
  consultantId String
  user         User       @relation(fields: [userId], references: [id])
  consultant   Consultant @relation(fields: [consultantId], references: [id])
  assignedAt   DateTime   @default(now())

  @@unique([userId, consultantId])
  @@map("consultant_managers")
}

model Skill {
  id       String  @id @default(uuid())
  name     String  @unique
  category String
  tenantId String?

  consultantSkills ConsultantSkill[]
  projectSkills    ProjectSkill[]

  @@map("skills")
}

model ConsultantSkill {
  id              String          @id @default(uuid())
  consultantId    String
  skillId         String
  competencyLevel CompetencyLevel
  yearsExperience Int
  confidenceLevel Int
  consultant      Consultant      @relation(fields: [consultantId], references: [id])
  skill           Skill           @relation(fields: [skillId], references: [id])

  @@unique([consultantId, skillId])
  @@map("consultant_skills")
}

model Certificate {
  id           String     @id @default(uuid())
  consultantId String
  title        String
  issuingBody  String
  startDate    DateTime?
  endDate      DateTime?
  uploadedAt   DateTime   @default(now())
  consultant   Consultant @relation(fields: [consultantId], references: [id])

  @@map("certificates")
}

model CvFile {
  id               String           @id @default(uuid())
  consultantId     String
  fileName         String
  mimeType         String
  fileSize         Int
  s3Key            String
  s3Url            String
  uploadStatus     UploadStatus     @default(UPLOADED)
  extractionStatus ExtractionStatus @default(PENDING)
  rawText          String?
  parsedData       Json?
  uploadedAt       DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  consultant       Consultant       @relation(fields: [consultantId], references: [id])

  @@map("cv_files")
}

model Project {
  id               String                   @id @default(uuid())
  projectName      String
  clientName       String
  description      String?
  addressLine1     String
  addressLine2     String?
  suburb           String?
  city             String
  province         String
  postalCode       String
  startDate        DateTime
  endDate          DateTime?
  teamSize         Int
  allocation       Int // Renamed from requiredAllocationPercentage
  budget           Float // Renamed from clientBillingBudget
  status           ProjectStatus            @default(OPEN)
  tenantId         String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  archivedAt       DateTime?                @map("archived_at")
  skills           ProjectSkill[]
  managers         ProjectManager[]
  placements       ProjectPlacement[]
  scoringOverrides ProjectScoringOverride[]

  auditLogs ProjectAuditLog[]
  matchRuns MatchRun[]

  @@map("projects")
}

model ProjectSkill {
  id         String          @id @default(uuid())
  projectId  String
  skillId    String
  competency CompetencyLevel // Renamed from minimumCompetency
  years      Int
  mandatory  Boolean         @default(true) // Renamed from isMandatory

  project Project @relation(fields: [projectId], references: [id])
  skill   Skill   @relation(fields: [skillId], references: [id])

  @@unique([projectId, skillId])
  @@map("project_skills")
}

model ProjectManager {
  id        String  @id @default(uuid())
  userId    String
  projectId String
  user      User    @relation(fields: [userId], references: [id])
  project   Project @relation(fields: [projectId], references: [id])

  @@unique([userId, projectId])
  @@map("project_managers")
}

model ProjectPlacement {
  id           String          @id @default(uuid())
  projectId    String
  consultantId String
  startDate    DateTime
  endDate      DateTime?
  allocation   Int
  status       PlacementStatus @default(ACTIVE)
  createdAt    DateTime        @default(now())
  project      Project         @relation(fields: [projectId], references: [id])
  consultant   Consultant      @relation(fields: [consultantId], references: [id])

  @@map("project_placements")
}

// Currently used to track archiving and unarchiving projects (can be used to track project status changes)
model ProjectAuditLog {
  id        String   @id @default(uuid())
  projectId String
  action    String // "ARCHIVED", "UNARCHIVED"
  userId    String // Admin or PM 
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])

  @@map("project_audit_logs")
}

model authAuditLog {
  id        String       @id @default(uuid())
  email     String
  outcome   AuditOutcome
  userId    String?
  ipAddress String
  userAgent String?
  timestamp DateTime     @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("auth_audit_logs")
}

model AdminAuditLog {
  id            String   @id @default(uuid())
  performedById String   @map("performed_by_id")
  targetUserId  String   @map("target_user_id")
  action        String
  previousValue String   @map("previous_value")
  newValue      String   @map("new_value")
  timestamp     DateTime @default(now())

  performedBy User @relation("AdminActions", fields: [performedById], references: [id])
  targetUser  User @relation("AdminTargets", fields: [targetUserId], references: [id])

  @@map("admin_audit_logs")
}

model ConsultantExperience {
  id           String     @id @default(uuid())
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id])
  jobTitle     String
  companyName  String
  jobType      JobType
  workModel    WorkModel
  startDate    DateTime
  endDate      DateTime?
  description  String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("consultant_experience")
}
model ConsultancyScoringConfig {
  id          String            @id @default(uuid())
  factorName  ScoringFactorName @unique
  weight      Float
  active      Boolean @default(true)
  hardExclusionEnabled   Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime @updatedAt

  @@map("consultancy_scoring_configs")
}

model ProjectScoringOverride {
  id             String            @id @default(uuid())
  projectId      String
  factorName     ScoringFactorName
  overrideWeight Float
  active         Boolean           @default(true)
  hardExclusionEnabled   Boolean           @default(false)
  createdAt      DateTime          @default(now())

  project        Project           @relation(fields: [projectId], references: [id])

  @@unique([projectId, factorName])
  @@map("project_scoring_overrides")
}

model ScoringConfigAudit {
  id             String   @id @default(uuid())
  adminUserId    String
  admin          User     @relation(fields: [adminUserId], references: [id])
  previousValues Json
  newValues      Json
  timestamp      DateTime @default(now())

  @@map("scoring_config_audit")
}


model Notification {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  title      String
  body       String
  isRead     Boolean  @default(false) @map("is_read")
  isArchived Boolean  @default(false) @map("is_archived")
  link       String?
  createdAt  DateTime @default(now()) @map("created_at")
  archivedAt DateTime @default(now()) @map("archived_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model MatchRun {
  id                     String           @id @default(uuid())
  projectId              String
  project                Project          @relation(fields: [projectId], references: [id])
  executedByUserId       String         
  executedByUser         User             @relation(fields: [executedByUserId], references: [id])
  status                 MatchRunStatus  
  totalConsultantsScored Int              @default(0)
  totalConsultantsExcluded Int              @default(0)
  results                MatchRunResult[]
  configurationSnapshot  Json
  
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
}

model MatchRunResult {
  id           String     @id @default(uuid())
  matchRunId   String
  matchRun     MatchRun   @relation(fields: [matchRunId], references: [id], onDelete: Cascade)
  consultantId String
  totalScore   Float
  rank         Int
  factorScores Json
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
}